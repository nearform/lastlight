{
  "name": "lastlight-code-facts",
  "version": "0.3.0",
  "description": "Deterministic program-analysis facts about a pull request — impact cone, contract delta, constants-minus-literals, dependency delta, scanner patterns and changed-line coverage. The substrate the Last Light reviewer reasons over.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "lastlight-facts": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./toolchain.json": "./toolchain.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "rules",
    "toolchain.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nearform/lastlight.git",
    "directory": "packages/code-facts"
  },
  "keywords": [
    "lastlight",
    "code-review",
    "static-analysis",
    "typescript",
    "ast-grep"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm run lint:boundaries",
    "test": "vitest run",
    "facts": "tsx src/cli.ts",
    "selfcheck": "tsx scripts/selfcheck.ts --repo ../..",
    "name-match-gate": "tsx scripts/name-match-gate.ts --repo ../..",
    "lint:boundaries": "node ../../scripts/lint-import-boundaries.mjs code-facts"
  },
  "dependencies": {
    "@ast-grep/napi": "^0.45.2",
    "typescript": "7.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
