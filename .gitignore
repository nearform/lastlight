# OS
.DS_Store

# Secrets & local config
.env
config.yaml
.github-token-cache.json
.gh-token
.gitconfig-bot

# Private deployment overlay (separate repo cloned here on prod; holds
# overlay config.yaml + asset overrides + a gitignored secrets/ subdir)
instance/

# Runtime state
sessions/
logs/
memories/
*.db
:memory:
*.db-shm
*.db-wal
*.pid
*.lock
*.pem

# State directory (mounted as Docker volume)
data/
# ...but `data/` is unanchored, so it also swallows apps/www/src/data/, which is
# real source. That silently dropped a new file from a commit and broke the www
# deploy; un-ignore it explicitly (the directory must be un-ignored before any
# file pattern inside it can match).
!apps/www/src/data/
mcp-config.json

# Build handoff docs — this repo is maintained by a server-mode Last Light
# instance, which keeps these on the server (never in the tree). Ignored so a
# repo-mode run or a stray commit can't reintroduce them.
.lastlight/

# Caches
cache/
audio_cache/
image_cache/
images/
# ...but agentic-pi ships tracked VM-image build configs (heavy out-* artifacts stay ignored)
!packages/agentic-pi/images/
packages/agentic-pi/images/*/out-*/
# ...and its VM-image source dir (manifest.ts/loader.ts) is real source, not a cache
!packages/agentic-pi/src/sandbox/images/
sandboxes/

# Debug
interrupt_debug.log

# Build output
dist/

# TypeScript incremental build cache
*.tsbuildinfo

# Turborepo cache
.turbo/

# Dependencies
node_modules/

# Bundled skills we don't use (Hermes may regenerate these)
skills/.bundled_manifest
skills/apple/
skills/autonomous-ai-agents/
skills/creative/
skills/data-science/
skills/diagramming/
skills/domain/
skills/email/
skills/feeds/
skills/gaming/
skills/gifs/
skills/inference-sh/
skills/leisure/
skills/media/
skills/mlops/
skills/note-taking/
skills/productivity/
skills/red-teaming/
skills/research/
skills/smart-home/
skills/social-media/

# Hermes internals
.skills_prompt_snapshot.json
.hermes_history
.update_check
auth.json
auth.lock
gateway_state.json
gateway.pid
channel_directory.json
discord_threads.json
modal_snapshots.json
response_store.db*
state.db*
pairing/
hooks/
!dashboard/src/hooks/
!apps/server/dashboard/src/hooks/
!.claude/hooks/
bin/
checkpoints/
whatsapp/
solo.yml

# Eval run outputs (scorecards, predictions)
evals/results/
