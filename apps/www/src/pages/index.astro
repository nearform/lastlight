	<script>
		// Keep the dashboard screenshots on the same theme as the page. The Nav
		// toggle flips html[data-theme], so observing that attribute works however
		// the theme changed (toggle click, or the pre-paint boot script).
		const shots = Array.from(document.querySelectorAll<HTMLImageElement>("img[data-shot]"));
		if (shots.length) {
			const syncShots = () => {
				const light = document.documentElement.getAttribute("data-theme") === "light";
				for (const img of shots) {
					img.src = `/screenshots/${img.dataset.shot}${light ? "-light" : ""}.png`;
				}
			};
			syncShots();
			new MutationObserver(syncShots).observe(document.documentElement, {
				attributes: true,
				attributeFilter: ["data-theme"],
			});
		}

		const lightbox = document.getElementById("tour-lightbox");
		const tour = document.getElementById("dashboard-tour");
		if (lightbox && tour) {
			const imgEl = lightbox.querySelector(".lightbox-image") as HTMLImageElement;
			const capEl = lightbox.querySelector(".lightbox-caption") as HTMLElement;
			const triggers = Array.from(
				tour.querySelectorAll<HTMLButtonElement>(".tour-card-trigger"),
			);
			const slides = triggers.map((btn) => {
				const img = btn.querySelector("img") as HTMLImageElement;
				const figcap = btn.parentElement?.querySelector("figcaption");
				const title = figcap?.querySelector("strong")?.textContent ?? "";
				const desc = figcap?.querySelector("span")?.textContent ?? "";
				// Keep the element, not its src: the theme sync above rewrites src,
				// and a value captured here would pin the lightbox to whichever
				// theme happened to be active at page load.
				return { img, alt: img.alt, title, desc };
			});

			let current = 0;
			let lastFocused: HTMLElement | null = null;

			const render = () => {
				const slide = slides[current];
				imgEl.src = slide.img.src;
				imgEl.alt = slide.alt;
				capEl.innerHTML = `<strong>${slide.title}</strong>${slide.desc}`;
			};

			const open = (index: number) => {
				current = index;
				lastFocused = document.activeElement as HTMLElement;
				render();
				lightbox.hidden = false;
				document.body.classList.add("lightbox-open");
				(lightbox.querySelector("[data-lightbox-close]") as HTMLButtonElement)?.focus();
			};

			const close = () => {
				lightbox.hidden = true;
				document.body.classList.remove("lightbox-open");
				lastFocused?.focus();
			};

			const step = (delta: number) => {
				current = (current + delta + slides.length) % slides.length;
				render();
			};

			triggers.forEach((btn, i) => {
				btn.addEventListener("click", () => open(i));
			});

			lightbox.addEventListener("click", (e) => {
				const target = e.target as HTMLElement;
				if (target === lightbox) close();
				if (target.closest("[data-lightbox-close]")) close();
				if (target.closest("[data-lightbox-prev]")) step(-1);
				if (target.closest("[data-lightbox-next]")) step(1);
			});

			document.addEventListener("keydown", (e) => {
				if (lightbox.hidden) return;
				if (e.key === "Escape") close();
				else if (e.key === "ArrowLeft") step(-1);
				else if (e.key === "ArrowRight") step(1);
			});
		}
	</script>

